.DS_Store
.idea/
.vscode/
*.swp

# Terraform local/generated files.
# Root module lock files (terraform/stack, terraform/foundation) are committed
# so provider versions are reproducible; only module-local ones are ignored.
**/.terraform/
terraform/modules/**/.terraform.lock.hcl
terraform/environments/*.tfvars
**/terraform.tfvars
**/*.tfstate
**/*.tfstate.*
bootstrap/backend-*.hcl
*.tfplan
*.plan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local secrets and credentials
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.ovpn
kubeconfig*
*.kubeconfig
argocd-repo-key*

# Local tooling output
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/

# Rendered local validation output
*.rendered.yaml
lessons_learned.md
