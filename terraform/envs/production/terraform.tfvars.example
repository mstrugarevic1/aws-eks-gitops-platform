project     = "my-platform"
environment = "production"
aws_region = "us-east-1"
azs        = ["us-east-1a", "us-east-1b", "us-east-1c"]

vpc_cidr             = "10.30.0.0/16"
public_subnet_cidrs  = ["10.30.1.0/24", "10.30.2.0/24", "10.30.3.0/24"]
private_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24", "10.30.13.0/24"]
nat_gateway_strategy = "per_az"

# Replace with the operator/VPN CIDR that is allowed to reach the EKS API.
eks_public_access_cidrs = ["203.0.113.10/32"]

node_desired_size = 3
node_min_size     = 2
node_max_size     = 6

rds_instance_class        = "db.t4g.micro"
rds_allocated_storage     = 20
rds_backup_retention_days = 3
rds_deletion_protection   = true
rds_skip_final_snapshot   = false
