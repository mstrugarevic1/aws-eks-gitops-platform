# Copy to production.tfvars and edit. *.tfvars files are gitignored.

project     = "my-platform"
environment = "production"

aws_region = "us-east-1"
azs        = ["us-east-1a", "us-east-1b", "us-east-1c"]

aws_account_id = "333333333333"

deployment_role_arn = (
  "arn:aws:iam::333333333333:role/platform-terraform-deploy"
)

vpc_cidr             = "10.30.0.0/16"
public_subnet_cidrs  = ["10.30.1.0/24", "10.30.2.0/24", "10.30.3.0/24"]
private_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24", "10.30.13.0/24"]
database_subnet_cidrs = [
  "10.30.21.0/24",
  "10.30.22.0/24",
  "10.30.23.0/24",
]
nat_gateway_strategy = "per_az"

eks_endpoint_public_access = false
eks_public_access_cidrs    = []

client_vpn = {
  enabled                    = true
  client_cidr_block          = "10.253.0.0/22"
  server_certificate_arn     = "arn:aws:acm:us-east-1:333333333333:certificate/server-certificate-id"
  root_certificate_chain_arn = "arn:aws:acm:us-east-1:333333333333:certificate/client-root-certificate-id"
  split_tunnel               = true
  dns_servers                = []
}

kubernetes_version  = "1.35"
node_instance_types = ["t3.large"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 6

rds_instance_class        = "db.t4g.small"
rds_allocated_storage     = 50
rds_backup_retention_days = 14
rds_username              = "app"
rds_db_name               = "app"
rds_multi_az              = true
rds_deletion_protection   = true
rds_skip_final_snapshot   = false

ecr_force_delete         = false
app_secret_recovery_days = 30

alarm_email = "platform-alerts@example.com"
