# Copy to staging.tfvars and edit. *.tfvars files are gitignored.

project     = "my-platform"
environment = "staging"

aws_region = "us-east-1"
azs        = ["us-east-1a", "us-east-1b"]

aws_account_id = "222222222222"

deployment_role_arn = (
  "arn:aws:iam::222222222222:role/platform-terraform-deploy"
)

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs = ["10.20.11.0/24", "10.20.12.0/24"]
database_subnet_cidrs = [
  "10.20.21.0/24",
  "10.20.22.0/24",
]
nat_gateway_strategy = "single"

eks_endpoint_public_access = false
eks_public_access_cidrs    = []

client_vpn = {
  enabled                    = true
  client_cidr_block          = "10.254.0.0/22"
  server_certificate_arn     = "arn:aws:acm:us-east-1:222222222222:certificate/server-certificate-id"
  root_certificate_chain_arn = "arn:aws:acm:us-east-1:222222222222:certificate/client-root-certificate-id"
  split_tunnel               = true
  dns_servers                = []
}

kubernetes_version  = "1.35"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4

rds_instance_class        = "db.t4g.micro"
rds_allocated_storage     = 20
rds_backup_retention_days = 7
rds_username              = "app"
rds_db_name               = "app"
rds_multi_az              = true
rds_deletion_protection   = true
rds_skip_final_snapshot   = false

ecr_force_delete         = false
app_secret_recovery_days = 30

alb_controller_version = "v3.4.2"

alarm_email = ""
